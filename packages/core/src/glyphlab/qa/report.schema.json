{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "passed",
    "findings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "glyphlab.qa-report/1"
    },
    "passed": {
      "type": "boolean"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "severity",
          "message",
          "detail"
        ],
        "additionalProperties": false,
        "properties": {
          "check_id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "FAIL",
              "WARN",
              "SKIPPED",
              "ALLOWED"
            ]
          },
          "message": {
            "type": "string"
          },
          "detail": {
            "type": [
              "object",
              "null"
            ]
          }
        }
      }
    }
  }
}
