      },
      "ArtifactResponse": {
        "properties": {
          "bytes": {
            "title": "Bytes",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "job_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Job Id"
          },
          "kind": {
            "enum": [
              "ttf",
              "woff2",
              "proof_html",
              "qa_json"
            ],
            "title": "Kind",
            "type": "string"
          },
          "sha256": {
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "job_id",
          "bytes",
          "sha256",
          "created_at"
        ],
        "title": "ArtifactResponse",
        "type": "object"
      },
      "BuildRequest": {
        "additionalProperties": false,
        "properties": {},
        "title": "BuildRequest",
        "type": "object"
      },
      "BuildResponse": {
        "properties": {
