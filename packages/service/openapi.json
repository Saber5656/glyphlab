          },
          "encoded": {
            "title": "Encoded",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "encoded",
          "drawn"
        ],
        "title": "CharsetInfo",
        "type": "object"
      },
      "CharsetMeta": {
        "properties": {
          "drawn": {
            "title": "Drawn",
            "type": "integer"
          },
          "encoded": {
            "title": "Encoded",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "pages": {
            "title": "Pages",
            "type": "integer"
          },
          "version": {
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "version",
          "encoded",
          "drawn",
          "pages"
        ],
        "title": "CharsetMeta",
        "type": "object"
      },
      "Counts": {
        "properties": {
          "accepted": {
            "default": 0,
            "title": "Accepted",
            "type": "integer"
          },
          "auto": {
            "default": 0,
            "title": "Auto",
            "type": "integer"
          },
          "missing": {
            "default": 0,
            "title": "Missing",
            "type": "integer"
          },
          "rejected": {
            "default": 0,
            "title": "Rejected",
            "type": "integer"
          }
        },
        "title": "Counts",
        "type": "object"
      },
      "CreateProject": {
        "additionalProperties": false,
        "properties": {
          "charset_id": {
            "default": "ja-basic-v1",
            "enum": [
              "ascii",
              "kana",
              "ja-basic-v1"
            ],
            "title": "Charset Id",
            "type": "string"
          },
          "family_name": {
            "maxLength": 31,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9 \\-]{0,29}[A-Za-z0-9\\-])?$",
            "title": "Family Name",
            "type": "string"
          },
          "name": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[^\\s\\x00-\\x1F\\x7F-\\x9F](?:[^\\x00-\\x1F\\x7F-\\x9F]{0,62}[^\\s\\x00-\\x1F\\x7F-\\x9F])?$",
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "family_name"
        ],
        "title": "CreateProject",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "additionalProperties": true,
            "title": "Detail",
            "type": "object"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
